# IT Avenue Workspace - Environment Variables
# Copy this file to .env and edit the values

# Backend
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
POSTGRES_USER=itavenue
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=itavenue
DATABASE_URL=postgresql://itavenue:change_me_in_production@db:5432/itavenue

# Auth
# Use a long random secret in production; never leave this as a default placeholder.
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d

# File storage
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=/app/uploads