# IT Avenue Workspace - Environment Variables
# Copy this file to .env and edit the values

# Backend
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
POSTGRES_USER=itavenue
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=itavenue
DATABASE_URL=postgresql://itavenue:change_me_in_production@db:5432/itavenue

# Auth
# Use a long random secret in production; never leave this as a default placeholder.
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d
# Exact account name allowed to receive the initial Superadmin role.
SUPERADMIN_USERNAME=

# File storage
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=/app/uploads

# WebRTC call connectivity (JSON array; add TURN credentials for restrictive networks)
WEBRTC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
# Number of reverse proxies in front of the backend (for example 1 behind Nginx).
# Leave empty when clients connect directly. Used so login rate limits see each
# person's real address.
TRUST_PROXY=

# One access-log line per request (method, path, status, time, address; no bodies or query strings).
LOG_REQUESTS=true
