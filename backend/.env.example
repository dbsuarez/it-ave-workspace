# IT Avenue Workspace - Backend Environment Variables
# Copy this file to .env and edit the values for your deployment.

# Backend
BACKEND_PORT=3001
FRONTEND_URL=https://itavenue.yourdomain.com

# Database
POSTGRES_USER=itavenue
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=itavenue
DATABASE_URL=postgresql://itavenue:change_me_in_production@db:5432/itavenue

# Auth
# Use a long random secret in production; never leave this as a default placeholder.
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
# Exact account name allowed to receive the initial Superadmin role.
SUPERADMIN_USERNAME=

# File storage
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=/app/uploads

# WebRTC ICE servers for Huddle (include public STUN and your own TURN if available)
WEBRTC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.yourdomain.com:3478","username":"turn_user","credential":"turn_password"}]'

# CORS origins (comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://itavenue.yourdomain.com,https://www.itavenue.yourdomain.com