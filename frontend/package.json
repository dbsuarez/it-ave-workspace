{
  "name": "itavenue-frontend",
  "productName": "IT Avenue Workspace",
  "version": "1.0.0",
  "description": "IT Avenue Workspace desktop client",
  "main": "main.js",
  "scripts": {
    "check": "node scripts/check.js",
    "vendor": "node scripts/vendor.js",
    "prestart": "npm run check",
    "start": "electron .",
    "dev": "electron .",
    "prepack": "npm run check",
    "pack": "electron-builder --dir",
    "predist": "npm run check",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@fontsource/lato": "^5.3.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "socket.io-client": "^4.7.2"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.itavenue.workspace",
    "productName": "IT Avenue Workspace",
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "IT Avenue Workspace uses your microphone for audio huddles."
      }
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/icon.png"
    }
  }
}
