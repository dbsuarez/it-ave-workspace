{
  "name": "itavenue-frontend",
  "productName": "IT Avenue Workspace",
  "version": "1.0.0",
  "description": "IT Avenue Workspace desktop client",
  "main": "main.js",
  "scripts": {
    "check": "node scripts/check.js",
    "test": "node --test \"test/*.test.js\"",
    "vendor": "node scripts/vendor.js",
    "editor": "node scripts/build-editor.js",
    "smoke": "node scripts/smoke.js",
    "verify:installer": "node scripts/verify-installer.js",
    "prestart": "npm run check",
    "start": "electron .",
    "dev": "electron .",
    "prepack": "npm run check",
    "pack": "electron-builder --dir",
    "predist": "npm run check",
    "dist": "electron-builder",
    "android:init": "cd android-capacitor && npm install && npx cap init",
    "android:open": "cd android-capacitor && npx cap open android",
    "android:sync": "cd android-capacitor && npx cap sync"
  },
  "devDependencies": {
    "@fontsource/lato": "^5.3.0",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-list": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extensions": "^3.33.1",
    "@tiptap/markdown": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "socket.io-client": "^4.7.2"
  },
  "dependencies": {
    "docx": "^9.15.3",
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.itavenue.workspace",
    "productName": "IT Avenue Workspace",
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "IT Avenue Workspace uses your microphone for audio huddles."
      }
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/icon.png"
    }
  }
}
